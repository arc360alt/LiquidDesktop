# Maintainer: arc360alt
#
# Builds LiquidDesktop from a git repository and installs it as a desktop session.
#
#   Easiest (no checkout needed):
#     curl -fsSL https://raw.githubusercontent.com/arc360alt/LiquidDesktop/main/install.sh | sh
#   From a checkout of the repo:
#     git clone https://github.com/arc360alt/LiquidDesktop && cd LiquidDesktop
#     yay -Bi packaging/arch            (or: cd packaging/arch && makepkg -si)
#   Another repo or branch: LIQUID_REPO='https://github.com/arc360alt/LiquidDesktop.git#branch=dev' makepkg -si
#
# Afterwards pick "LiquidDesktop" on your login screen, or run `liquid-desktop` to try it in a window.

pkgname=liquid-desktop-git
_name=liquid-desktop
pkgver=0.3.0
pkgrel=1
pkgdesc='A Liquid Glass desktop environment written in JavaScript (Electron UI, X11 window manager, picom compositor)'
arch=('any')
url='https://github.com/arc360alt/LiquidDesktop'
license=('MIT' 'CC-BY-NC-ND-4.0')   # LiquidDesktop is MIT; the bundled macOS Tahoe cursors are CC BY-NC-ND
_repo="${LIQUID_REPO:-https://github.com/arc360alt/LiquidDesktop.git#branch=main}"

depends=(
  'electron43'          # runs the UI and the window manager
  'picom'               # compositor: blur behind glass, rounded corners, shadows
  'python'              # tiny PTY bridge for the Terminal app
  'xorg-server'         # the session is an X11 session
  'xdg-utils'           # opening files with other apps
  'ttf-font'
  'xsettingsd'          # tells GTK apps which cursor theme to use
  'xorg-xrdb'           # …and libXcursor (Qt, Chromium) via X resources
  'xorg-xinput'         # mouse & trackpad settings in the session
  'kvantum'             # Qt apps in the MacTahoe theme (Settings › Appearance › App Themes)
  'sassc'               # builds MacTahoe's GTK 4 / libadwaita version
  'wlroots0.20'         # liquid-wl-bridge: Android (Waydroid) apps as their own windows
  'udisks2'             # USB drives in Files: opening (mounting) and ejecting
  'android-tools'       # adb: Android app window sizes and desktop settings (Settings › Android)
)
optdepends=(
  'power-profiles-daemon: power modes (Settings › Battery)'
  'openrgb: RGB lighting control (the Lighting app)'
  'networkmanager: Wi-Fi status, network list and joining (nmcli)'
  'wireplumber: volume control (wpctl)'
  'libpulse: volume control fallback (pactl)'
  'brightnessctl: screen brightness'
  'bluez-utils: Bluetooth toggle (bluetoothctl)'
  'playerctl: Now Playing in Control Center'
  'upower: battery details'
  'glib2: move to Trash via gio'
  'xorg-xwayland: run the session nested in a window on Wayland (liquid-desktop-nested)'
  'xorg-server-xephyr: run the session nested in a window on X11'
  'mesa-utils: GPU detection for the nested session'
  'xfce4-terminal: a native terminal for Linux apps that need one'
  'flatpak: install apps from Flathub in the App Store'
  'pacman-contrib: check for Arch Linux updates in the App Store (checkupdates)'
  'archlinux-appstream-data: names, icons and descriptions for Arch Linux apps in the App Store'
  'sddm: the LiquidDesktop login screen (installed and selected automatically)'
  'qt6-svg: icons on the LiquidDesktop login screen'
  "greetd: LiquidDesktop's own (web) login screen"
  "cage: runs LiquidDesktop's own login screen"
  "xorg-xinit: starting X11 sessions from LiquidDesktop's own login screen (startx)"
)
backup=('etc/sddm.conf.d/zz-liquid-desktop.conf')
makedepends=('git' 'npm' 'nodejs' 'meson' 'wayland-protocols')
provides=("$_name")
conflicts=("$_name")
options=('!strip' '!debug')
# the default cursors: "MacOS Tahoe Cursor" by MOYASH (CC BY-NC-ND), installed unmodified from its release
_cursor=1.2
source=("$_name::git+$_repo"
        "MacOS-Tahoe-Cursor-$_cursor.zip::https://github.com/witt-bit/MacOS-Tahoe-Cursor/releases/download/$_cursor/MacOS-Tahoe-Cursor.zip")
sha256sums=('SKIP'
            '684b80296a0419597f7efeb5c80d3d9527f8a6639d0d98a498e62ed8fa8d8e12')
noextract=("MacOS-Tahoe-Cursor-$_cursor.zip")

pkgver() {
  cd "$_name"
  local v
  v=$(node -p "require('./package.json').version" 2>/dev/null || echo 0.0.0)
  printf '%s.r%s.%s' "$v" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$_name"
  # runtime JS dependencies only — Electron itself comes from the electron43 package
  npm ci --omit=dev --no-audit --no-fund --ignore-scripts
  # unpack the cursor theme (checksummed above) into session/cursors/MacOS-Tahoe-Cursor
  LIQUID_CURSOR_ZIP="$srcdir/MacOS-Tahoe-Cursor-$_cursor.zip" sh tools/fetch-cursors.sh
  # the Wayland-to-X11 bridge Android apps run through (see bridge/main.c)
  meson setup bridge/build bridge --buildtype=release
  meson compile -C bridge/build
}

package() {
  cd "$_name"
  local dest="$pkgdir/usr/lib/$_name"
  install -dm755 "$dest"
  cp -a main renderer session tools package.json "$dest/"
  # the login theme, so Settings › Lock Screen can (re)install it
  install -dm755 "$dest/packaging" && cp -a packaging/sddm packaging/greetd-config.toml "$dest/packaging/"
  # Android (Settings › Android): the overlay that removes Android’s own title bar from app windows
  install -Dm644 packaging/android/LiquidNoCaption.apk "$dest/packaging/android/LiquidNoCaption.apk"
  cp -r node_modules "$dest/"
  install -Dm755 bridge/build/liquid-wl-bridge "$dest/bridge/liquid-wl-bridge"
  rm -rf "$dest/node_modules/.package-lock.json" "$dest/tools/shot.js"
  chmod 755 "$dest/session/liquid-desktop" "$dest/session/liquid-desktop-session" "$dest/session/liquid-desktop-update" \
            "$dest/session/liquid-desktop-session-inner" "$dest/tools/nested.sh" "$dest/tools/xephyr-test.sh" \
            "$dest/session/liquid-desktop-open" "$dest/session/liquid-desktop-greeter"

  # commands
  install -dm755 "$pkgdir/usr/bin"
  ln -s "/usr/lib/$_name/session/liquid-desktop" "$pkgdir/usr/bin/liquid-desktop"
  ln -s "/usr/lib/$_name/session/liquid-desktop-session" "$pkgdir/usr/bin/liquid-desktop-session"
  ln -s "/usr/lib/$_name/tools/nested.sh" "$pkgdir/usr/bin/liquid-desktop-nested"
  ln -s "/usr/lib/$_name/session/liquid-desktop-update" "$pkgdir/usr/bin/liquid-desktop-update"
  ln -s "/usr/lib/$_name/session/liquid-desktop-open" "$pkgdir/usr/bin/liquid-desktop-open"
  ln -s "/usr/lib/$_name/session/liquid-desktop-greeter" "$pkgdir/usr/bin/liquid-desktop-greeter"
  # LiquidDesktop's own login screen (greetd greeter): a place for its data
  install -Dm644 packaging/liquid-desktop-greeter.tmpfiles.conf "$pkgdir/usr/lib/tmpfiles.d/liquid-desktop-greeter.conf"

  # LiquidDesktop's Open / Save dialogs for every app (desktop portal backend) and Files as the folder opener
  install -Dm644 packaging/liquiddesktop.portal "$pkgdir/usr/share/xdg-desktop-portal/portals/liquiddesktop.portal"
  install -Dm644 packaging/liquid-desktop-files.desktop "$pkgdir/usr/share/applications/liquid-desktop-files.desktop"

  # login screen entry (X11 session)
  install -Dm644 packaging/liquid-desktop.xsession.desktop "$pkgdir/usr/share/xsessions/liquid-desktop.desktop"
  # app menu entry for the testing window
  install -Dm644 packaging/liquid-desktop.desktop "$pkgdir/usr/share/applications/liquid-desktop.desktop"

  # login screen (SDDM theme), switched on by a drop-in that sorts after other SDDM settings
  install -dm755 "$pkgdir/usr/share/sddm/themes/liquid-desktop"
  cp -a packaging/sddm/liquid-desktop/. "$pkgdir/usr/share/sddm/themes/liquid-desktop/"
  install -Dm644 packaging/sddm/zz-liquid-desktop.conf "$pkgdir/etc/sddm.conf.d/zz-liquid-desktop.conf"

  # cursor theme, also selectable in other desktops
  install -dm755 "$pkgdir/usr/share/icons"
  cp -a session/cursors/LiquidCursor "$pkgdir/usr/share/icons/"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  [ -f session/cursors/MacOS-Tahoe-Cursor/ReadMe.txt ] && \
    install -Dm644 session/cursors/MacOS-Tahoe-Cursor/ReadMe.txt "$pkgdir/usr/share/licenses/$pkgname/MacOS-Tahoe-Cursor-ReadMe.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_name/README.md"
}
