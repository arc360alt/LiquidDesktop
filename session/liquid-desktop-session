#!/bin/sh
# LiquidDesktop X11 session. Started by a display manager (liquid-desktop.desktop), by startx/xinit,
# or nested for testing (tools/xephyr-test.sh). LiquidDesktop itself is the window manager.
HERE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
export XDG_CURRENT_DESKTOP=LiquidDesktop
export XDG_SESSION_DESKTOP=LiquidDesktop
export XDG_SESSION_TYPE=x11
export GDK_BACKEND=x11
export QT_QPA_PLATFORM=xcb
export GTK_CSD=0
# LiquidDesktop's cursors, for the desktop itself and every app started in the session
# the cursor theme chosen in Settings › Mouse (macOS Tahoe by default, LiquidCursor if it wasn't downloaded)
CUR_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/LiquidDesktop/cursor-theme"
[ -r "$CUR_FILE" ] && read -r SAVED_THEME SAVED_SIZE < "$CUR_FILE"
DEFAULT_CURSOR=LiquidCursor; [ -d "$HERE/session/cursors/MacOS-Tahoe-Cursor/cursors" ] && DEFAULT_CURSOR=MacOS-Tahoe-Cursor
export XCURSOR_THEME="${XCURSOR_THEME_OVERRIDE:-${SAVED_THEME:-$DEFAULT_CURSOR}}"
export XCURSOR_SIZE="${SAVED_SIZE:-48}"
export XCURSOR_PATH="$HERE/session/cursors:$HOME/.local/share/icons:$HOME/.icons:/usr/share/icons:/usr/share/pixmaps"
unset ELECTRON_RUN_AS_NODE WAYLAND_DISPLAY

command -v xsetroot >/dev/null && xsetroot -cursor_name left_ptr || true

# Tell every app about the cursor theme the standard X11 ways. X resources are read by libXcursor
# (Qt, Chromium, xterm…); XSETTINGS are read by GTK apps and take priority over gtk-3.0/settings.ini.
# Settings › Displays › Interface size (ui-scale, in percent): LiquidDesktop scales itself with it (main/main.js);
# other apps get it as the screen's DPI (96 = 100%), which GTK, Qt, Chromium and Electron apps size their text by.
UI_SCALE="$(tr -dc '0-9' < "${XDG_CONFIG_HOME:-$HOME/.config}/LiquidDesktop/ui-scale" 2>/dev/null)"
UI_DPI=""
[ -n "$UI_SCALE" ] && [ "$UI_SCALE" -ge 75 ] && [ "$UI_SCALE" -le 300 ] && [ "$UI_SCALE" -ne 100 ] && UI_DPI=$((96 * UI_SCALE / 100))
if command -v xrdb >/dev/null; then
  printf 'Xcursor.theme: %s\nXcursor.size: %s\n' "$XCURSOR_THEME" "$XCURSOR_SIZE" | xrdb -merge
  [ -n "$UI_DPI" ] && printf 'Xft.dpi: %s\n' "$UI_DPI" | xrdb -merge
fi
if command -v xsettingsd >/dev/null; then
  XSD_CONF="${XDG_RUNTIME_DIR:-/tmp}/liquid-desktop-xsettingsd.conf"
  printf 'Gtk/CursorThemeName "%s"\nGtk/CursorThemeSize %s\n' "$XCURSOR_THEME" "$XCURSOR_SIZE" > "$XSD_CONF"
  [ -n "$UI_DPI" ] && printf 'Xft/DPI %s\n' "$((UI_DPI * 1024))" >> "$XSD_CONF"
  xsettingsd -c "$XSD_CONF" >/dev/null 2>&1 &
  XSD=$!
fi

# Your rendering choice (Settings › Developer › Rendering), saved per user, overrides what the system set (e.g.
# Lumen's /etc/environment when no real GPU driver drives the screen):
#   hardware  the GPU: the software-rendering variables are dropped, and "--backend xrender" from LIQUID_PICOM_ARGS
#   software  no GPU: the variables are set
#   automatic (no file) whatever the system set, plus the llvmpipe check below
RENDER_CHOICE="$(cat "${XDG_CONFIG_HOME:-$HOME/.config}/LiquidDesktop/rendering" 2>/dev/null | tr -d '[:space:]')"
case "$RENDER_CHOICE" in
  hardware)
    unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER LIQUID_SOFTWARE_RENDERING
    LIQUID_PICOM_ARGS="$(printf ' %s ' "$LIQUID_PICOM_ARGS" | sed 's/ --backend[ =]xrender / /g; s/^ *//; s/ *$//')"
    export LIQUID_PICOM_ARGS
    LIQUID_RENDERING_FORCED=1 ;;
  software)
    export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe LIQUID_SOFTWARE_RENDERING=1
    case " $LIQUID_PICOM_ARGS " in *" --backend"*) ;; *) LIQUID_PICOM_ARGS="${LIQUID_PICOM_ARGS:+$LIQUID_PICOM_ARGS }--backend xrender" ;; esac
    export LIQUID_PICOM_ARGS
    LIQUID_RENDERING_FORCED=1 ;;
esac

# Software rendering (no usable GPU): LIQUID_SOFTWARE_RENDERING=1 or LIBGL_ALWAYS_SOFTWARE=1 set by the distro or
# you, or OpenGL turns out to be llvmpipe (a VM without virgl, a missing driver). LiquidDesktop then draws
# without the GPU (main/main.js) and picom uses a config without GLX-only features (blur, shaders, GLX vsync).
if [ -z "$LIQUID_SOFTWARE_RENDERING" ] && [ "$LIBGL_ALWAYS_SOFTWARE" = 1 ]; then LIQUID_SOFTWARE_RENDERING=1; fi
# what OpenGL / GLX is here (asked once; used for the llvmpipe check and the NVIDIA settings below)
GLXINFO=""
[ -z "$LIQUID_SOFTWARE_RENDERING" ] && command -v glxinfo >/dev/null && GLXINFO="$(glxinfo -B 2>/dev/null)"
if [ -z "$LIQUID_SOFTWARE_RENDERING" ] \
    && printf '%s\n' "$GLXINFO" | grep -i "renderer string" | grep -qiE "llvmpipe|softpipe|swrast"; then
  LIQUID_SOFTWARE_RENDERING=1
  # "hardware" chosen in Settings, but there's no GPU OpenGL at all right now (a driver that didn't load: often an
  # update that needs a restart, when the kernel module and the driver's libraries differ). GPU drawing would give
  # a black desktop, so this session draws in software; the saved choice is kept for the next one.
  if [ -n "$LIQUID_RENDERING_FORCED" ]; then
    echo "liquid-desktop: Rendering is set to hardware, but OpenGL is software (llvmpipe) — no GPU driver is working (restart after a driver update?): using software rendering this time" >&2
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [session] hardware rendering chosen but OpenGL is llvmpipe: software rendering this session" >> "${XDG_CONFIG_HOME:-$HOME/.config}/LiquidDesktop/crashes.log" 2>/dev/null
    export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe
  else
    echo "liquid-desktop: OpenGL is software (llvmpipe): using software rendering" >&2
  fi
fi
[ "$LIQUID_SOFTWARE_RENDERING" = 1 ] && export LIQUID_SOFTWARE_RENDERING || unset LIQUID_SOFTWARE_RENDERING

# NVIDIA's own driver drives the screen (its GLX, not just the driver being loaded: on hybrid laptops the
# screen is usually driven by the Intel/AMD chip). picom's GLX backend then needs:
#   --xrender-sync-fence  wait for apps' drawing to finish before using it (otherwise windows show black or
#                         stale until something else changes them: a black wallpaper, app windows that never appear)
#   --no-use-damage       redraw whole frames: with NVIDIA's driver, redrawing only changed parts leaves areas
#                         unrefreshed (the same symptoms); a whole frame costs a discrete GPU next to nothing
# (glx-no-stencil is gone in picom 11+, and vsync works with NVIDIA's GLX, so those stay as they are.) Both are
# added to LIQUID_PICOM_ARGS unless it already says otherwise, so a distro's own flags win and nothing doubles up.
# Without glxinfo (it's in an optional package) the RandR providers tell: "NVIDIA-0" is NVIDIA's driver driving
# the screen; "NVIDIA-G0" is only a render-offload GPU on a hybrid laptop (the screen is the other chip's).
LIQUID_NVIDIA=""
if [ "$LIQUID_SOFTWARE_RENDERING" != 1 ] && { [ "$__GLX_VENDOR_LIBRARY_NAME" = nvidia ] \
    || printf '%s\n' "$GLXINFO" | grep -qiE "(server glx vendor string|client glx vendor string|OpenGL vendor string):[[:space:]]*NVIDIA" \
    || { [ -z "$GLXINFO" ] && command -v xrandr >/dev/null && xrandr --listproviders 2>/dev/null | grep -q 'name:NVIDIA-0'; }; }; then
  LIQUID_NVIDIA=1
  case " $LIQUID_PICOM_ARGS " in *" --xrender-sync-fence "*) ;; *) LIQUID_PICOM_ARGS="${LIQUID_PICOM_ARGS:+$LIQUID_PICOM_ARGS }--xrender-sync-fence" ;; esac
  case " $LIQUID_PICOM_ARGS " in *" --use-damage "*|*" --no-use-damage "*) ;; *) LIQUID_PICOM_ARGS="$LIQUID_PICOM_ARGS --no-use-damage" ;; esac
  export LIQUID_PICOM_ARGS LIQUID_NVIDIA
  echo "liquid-desktop: NVIDIA driver: picom $LIQUID_PICOM_ARGS" >&2
  # Several monitors: NVIDIA's GLX syncs to whichever monitor it picks first (often not the main one, or a slower
  # one), and the whole desktop then stutters. Sync to the main monitor instead (unless you set it yourself).
  if [ -z "$__GL_SYNC_DISPLAY_DEVICE" ] && command -v xrandr >/dev/null \
      && [ "$(xrandr --listactivemonitors 2>/dev/null | sed -n 's/^Monitors: //p')" -gt 1 ] 2>/dev/null; then
    LIQUID_SYNC_OUT="$(xrandr --query 2>/dev/null | awk '/ connected primary [0-9]/ { print $1; exit }')"
    [ -n "$LIQUID_SYNC_OUT" ] && export __GL_SYNC_DISPLAY_DEVICE="$LIQUID_SYNC_OUT" && echo "liquid-desktop: NVIDIA vsync on $LIQUID_SYNC_OUT" >&2
  fi
fi

# the compositor: real blur behind the glass, rounded corners, shadows. Software rendering, or a picom backend
# other than glx/egl asked for in LIQUID_PICOM_ARGS (Lumen sets "--backend xrender"): the software config.
# LIQUID_PICOM_ARGS is always added on top.
PICOM_CONF="$HERE/session/picom.conf"
case " $LIQUID_PICOM_ARGS " in
  *" --backend glx "*|*" --backend=glx "*|*" --backend egl "*|*" --backend=egl "*) ;;
  *" --backend "*|*" --backend="*) PICOM_CONF="$HERE/session/picom-software.conf" ;;
esac
[ "$LIQUID_SOFTWARE_RENDERING" = 1 ] && PICOM_CONF="$HERE/session/picom-software.conf"
# picom is started and watched by a small loop below. When it can't start with a configuration (GLX features the
# driver lacks, an NVIDIA option that driver version doesn't take…) the next one is tried, ending with software
# rendering — before, the session simply ran without a compositor, and the transparent shell layers then covered
# every monitor in black. When it crashes later (a display change can do that) it's started again; if one
# configuration keeps crashing, the next one is used. LiquidDesktop also cuts its layers down to what they show
# while no compositor runs (main/wm.js), so a monitor never goes black in the meantime.
# Its pid is kept in a file: after the monitors are rearranged LiquidDesktop resets it (SIGUSR1, main/session.js).
picom_log() {
  echo "liquid-desktop: $*" >&2
  { mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/LiquidDesktop" \
    && echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [picom] $*" >> "${XDG_CONFIG_HOME:-$HOME/.config}/LiquidDesktop/crashes.log"; } 2>/dev/null
}
no_backend() { printf ' %s ' "$1" | sed 's/ --backend[ =][^ ]* / /g; s/^ *//; s/ *$//'; }
no_nvidia() { printf ' %s ' "$1" | sed 's/ --xrender-sync-fence / /g; s/ --no-use-damage / /g; s/^ *//; s/ *$//'; }
# configuration N to try, as "config file|arguments"; nothing when there's no such step
GPU_CONF="$HERE/session/picom.conf"
picom_variant() {
  case "$1" in
    0) echo "$PICOM_CONF|$LIQUID_PICOM_ARGS" ;;
    # NVIDIA: the GPU config without the extra NVIDIA options (some driver/picom versions refuse the sync fence)
    1) [ -n "$LIQUID_NVIDIA" ] && [ "$PICOM_CONF" = "$GPU_CONF" ] && echo "$PICOM_CONF|$(no_nvidia "$LIQUID_PICOM_ARGS")" ;;
    # GPU config, explicitly GLX, without any backend someone asked for
    2) [ "$PICOM_CONF" = "$GPU_CONF" ] && echo "$PICOM_CONF|$(no_backend "$LIQUID_PICOM_ARGS") --backend glx" ;;
    # software rendering: no blur, but a working desktop. NVIDIA keeps its sync fence (xrender uses it too), not
    # --no-use-damage (a GLX workaround). Not tried, as measured on NVIDIA under Xwayland (the nested session):
    #  - Mesa's GLX/EGL through Zink: picom starts but draws only black (or, with Kopper off, becomes llvmpipe)
    #  - blur on xrender: the X server does it on the CPU (glamor doesn't accelerate it): 2–6 cores at a few fps
    3) echo "$HERE/session/picom-software.conf|$(no_backend "$(printf ' %s ' "$LIQUID_PICOM_ARGS" | sed 's/ --no-use-damage / /g')") --backend xrender" ;;
  esac
}
PICOM_PIDFILE="${XDG_RUNTIME_DIR:-/tmp}/liquid-desktop-picom-$(printf '%s' "$DISPLAY" | tr -c 'A-Za-z0-9' _).pid"
export LIQUID_PICOM_PIDFILE="$PICOM_PIDFILE"
picom_supervise() {
  CUR=""
  trap '[ -n "$CUR" ] && kill "$CUR" 2>/dev/null; rm -f "$PICOM_PIDFILE"; exit 0' TERM INT HUP
  V=0; CRASHES=0; TRIED="|"
  while [ "$V" -le 3 ]; do
    SPEC="$(picom_variant "$V")"
    case "$TRIED" in *"|$SPEC|"*) SPEC="" ;; esac   # nothing new to try at this step
    if [ -z "$SPEC" ]; then V=$((V + 1)); continue; fi
    CONF="${SPEC%%|*}"; ARGS="${SPEC#*|}"
    T0=$(date +%s)
    # shellcheck disable=SC2086
    picom --config "$CONF" $ARGS &
    CUR=$!
    echo "$CUR" > "$PICOM_PIDFILE"
    wait "$CUR"
    CODE=$?
    CUR=""
    RAN=$(( $(date +%s) - T0 ))
    if [ "$RAN" -lt 8 ]; then
      picom_log "picom could not start ($(basename "$CONF") $ARGS, exit $CODE): trying the next configuration"
      TRIED="$TRIED$SPEC|"; V=$((V + 1)); CRASHES=0
      continue
    fi
    [ "$RAN" -gt 600 ] && CRASHES=0
    CRASHES=$((CRASHES + 1))
    if [ "$CRASHES" -ge 4 ]; then
      picom_log "picom keeps exiting ($(basename "$CONF") $ARGS, exit $CODE): trying the next configuration"
      TRIED="$TRIED$SPEC|"; V=$((V + 1)); CRASHES=0
    else
      picom_log "picom exited after ${RAN}s (exit $CODE): starting it again"
      sleep 1
    fi
  done
  rm -f "$PICOM_PIDFILE"
  picom_log "no picom configuration works here: running without a compositor (no blur or shadows)"
}
if command -v picom >/dev/null; then
  picom_supervise &
  PICOM=$!
  sleep 0.5
else
  echo "liquid-desktop: picom not found — install it for blur, rounded corners and shadows" >&2
fi

# Flatpak apps (Sober, Steam, Discord…) talk to xdg-desktop-portal, which D-Bus/systemd start for us. Without
# this session's DISPLAY they get a portal that can't open anything (or one still pointing at an earlier
# Wayland login) and the app hangs on launch. KDE/GNOME do the same at login.
PORTAL_VARS="DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XCURSOR_THEME XCURSOR_SIZE XCURSOR_PATH GDK_BACKEND QT_QPA_PLATFORM GTK_CSD"
if [ -z "$LIQUID_NESTED_SESSION" ] && [ -n "$DBUS_SESSION_BUS_ADDRESS" ]; then
  if command -v dbus-update-activation-environment >/dev/null; then
    # shellcheck disable=SC2086
    dbus-update-activation-environment --systemd $PORTAL_VARS >/dev/null 2>&1
  fi
  if command -v systemctl >/dev/null; then
    systemctl --user unset-environment WAYLAND_DISPLAY >/dev/null 2>&1
    # portals left running from an earlier login still use its display: restart on demand with ours
    systemctl --user stop xdg-desktop-portal.service xdg-desktop-portal-kde.service xdg-desktop-portal-gtk.service \
      xdg-desktop-portal-gnome.service xdg-desktop-portal-hyprland.service xdg-desktop-portal-wlr.service >/dev/null 2>&1
  fi
fi
# Which portal backend serves "LiquidDesktop": one that works on X11 (KDE's, else GTK's), never a
# Wayland-only one (Hyprland, wlroots), which would fail and leave apps waiting.
PORTAL_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/xdg-desktop-portal/liquiddesktop-portals.conf"
if [ ! -e "$PORTAL_CONF" ] || grep -q '^# written by LiquidDesktop' "$PORTAL_CONF" 2>/dev/null; then
  PORTALS=""
  for P in kde gnome gtk; do [ -e "/usr/share/xdg-desktop-portal/portals/$P.portal" ] && PORTALS="$PORTALS$P;"; done
  SECRET=""
  for P in kwallet gnome-keyring; do [ -e "/usr/share/xdg-desktop-portal/portals/$P.portal" ] && SECRET="$SECRET$P;"; done
  if [ -n "$PORTALS" ]; then
    mkdir -p "$(dirname "$PORTAL_CONF")"
    { echo '# written by LiquidDesktop at login (delete this line to keep your own edits)'
      echo '[preferred]'
      echo "default=$PORTALS"
      [ -n "$SECRET" ] && echo "org.freedesktop.impl.portal.Secret=$SECRET"
      # LiquidDesktop's own Open / Save dialogs (main/portal.js), when installed
      if [ -e /usr/share/xdg-desktop-portal/portals/liquiddesktop.portal ]; then
        echo "org.freedesktop.impl.portal.FileChooser=liquiddesktop;$PORTALS"
        echo "org.freedesktop.impl.portal.AppChooser=liquiddesktop;$PORTALS"
      fi
    } > "$PORTAL_CONF"
  fi
fi

# Apps use the desktop portal for Open / Save, so they get LiquidDesktop's dialog: GTK 3 (GTK_USE_PORTAL),
# GTK 4 (GDK_DEBUG=portals) and Qt (its xdgdesktopportal platform theme). Firefox, Chromium and Flatpak apps
# use the portal on their own. Only when LiquidDesktop's dialog is installed.
if [ -e /usr/share/xdg-desktop-portal/portals/liquiddesktop.portal ]; then
  export GTK_USE_PORTAL=1 GDK_DEBUG="${GDK_DEBUG:+$GDK_DEBUG,}portals"
  for D in /usr/lib/qt6/plugins/platformthemes /usr/lib/x86_64-linux-gnu/qt6/plugins/platformthemes /usr/lib64/qt6/plugins/platformthemes; do
    [ -e "$D/libqxdgdesktopportal.so" ] && { export QT_QPA_PLATFORMTHEME=xdgdesktopportal; break; }
  done
fi
# Apps' menus in the menu bar (main/appmenu.js): Qt, KDE, Chromium and Electron apps do it on their own; GTK 2/3
# apps need appmenu-gtk-module. Off when turned off in Settings › Menu Bar (they keep menus in their windows).
if [ ! -e "${XDG_CONFIG_HOME:-$HOME/.config}/LiquidDesktop/global-menu-off" ]; then
  for M in /usr/lib/gtk-3.0/modules /usr/lib/x86_64-linux-gnu/gtk-3.0/modules /usr/lib64/gtk-3.0/modules; do
    if [ -e "$M/libappmenu-gtk-module.so" ]; then
      case ":$GTK_MODULES:" in *:appmenu-gtk-module:*) ;; *) export GTK_MODULES="${GTK_MODULES:+$GTK_MODULES:}appmenu-gtk-module" ;; esac
      break
    fi
  done
fi
# Folders open in LiquidDesktop's Files: a default that only applies in this session (the
# "liquiddesktop-mimeapps.list" is read only when XDG_CURRENT_DESKTOP is LiquidDesktop)
MIMEAPPS="${XDG_CONFIG_HOME:-$HOME/.config}/liquiddesktop-mimeapps.list"
# (LiquidDesktop rewrites it with every Default Apps choice once it's running; this is just the starting point)
if [ ! -e "$MIMEAPPS" ]; then
  printf '%s\n' '# written by LiquidDesktop at login (delete this line to keep your own edits)' '[Default Applications]' \
    'inode/directory=liquid-desktop-files.desktop' 'x-directory/normal=liquid-desktop-files.desktop' > "$MIMEAPPS"
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null; then
  dbus-run-session -- "$HERE/session/liquid-desktop-session-inner" "$HERE"
else
  "$HERE/session/liquid-desktop-session-inner" "$HERE"
fi
[ -n "$PICOM" ] && kill $PICOM 2>/dev/null
[ -n "$XSD" ] && kill $XSD 2>/dev/null
